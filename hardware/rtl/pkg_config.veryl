
// All parameters to configure TinyMOA live here

pub package pkg_soc {
    const XLEN: u32 = 32; // 32 or 64 ONLY!!
}

pub package pkg_cpu {
    import pkg_soc;

    // CPU always enabled
    const USE_LINUX: bbool = true;

    // IMAFDC_Zbb_Zcb_Zicsr_Zicond_Zifencei_Zfbfmin
    const USE_EXT_Zfbfmin : bbool = true;
    const USE_EXT_Zifencei: bbool = true || USE_LINUX;
    const USE_EXT_Zicond  : bbool = true;
    const USE_EXT_Zicsr   : bbool = true || USE_LINUX;
    const USE_EXT_Zcb     : bbool = true; // Zca not added, Zcb is the superset
    const USE_EXT_Zbb     : bbool = true;
    const USE_EXT_C       : bbool = true || USE_EXT_Zcb; // recommended if using linux
    const USE_EXT_D       : bbool = true || USE_LINUX;
    const USE_EXT_F       : bbool = true || USE_LINUX || USE_EXT_D || USE_EXT_Zfbfmin;
    const USE_EXT_A       : bbool = true || USE_LINUX;
    const USE_EXT_M       : bbool = true || USE_LINUX;
    const USE_EXT_I       : bbool = true || USE_LINUX;
    // const USE_EXT_LPU     : bbool = pkg_lpu::LPU_EN; // custom LPU ISA

    // required linux MMUs, let params auto set
    const USE_MMU_Sv32: bbool = USE_LINUX && (pkg_soc::XLEN == 32);
    const USE_MMU_Sv39: bbool = USE_LINUX && (pkg_soc::XLEN == 64);

    const ALU_W_OP_EN: bbool = pkg_soc::XLEN >= 32; // *W ops for 64/128-bit ISA

    enum SrcType: logic<2> {
        ZERO,
        REG,
        IMM,
        PC,
    }

    enum DstType: logic<2> {
        NONE,
        REG,
        MEM,
    }

    // CPU frontend

    const USE_BPU: bbool = true;

    const FETCH_WIDTH : u32 = 8;
    const DECODE_WIDTH: u32 = 8;
    const ROB_ENTRIES : u32 = 128;

    const REGFILE_INT_NUM : u32 = 128;
    const REGFILE_FP_NUM  : u32 = 96;
    const REGFILE_VEC_NUML: u32 = 96;

    // CPU backend execution units (EUs)
    const ALU_NUM: u32 = 4;
    const FPU_NUM: u32 = 2;
    const VPU_NUM: u32 = 2;
    const AGU_NUM: u32 = 2;
}

pub package pkg_lpu {
    const LPU_EN: bbool = true;

    const CIM_DIM    : u32 = 32; // NxN corelet array
    const CORELET_DIM: u32 = 8;  // corelet KxK size
    const CORELET_MLC: u32 = 4;  // bits/cell

    // Informed from
    // https://github.com/deepseek-ai/DeepSeek-V3.2-Exp/blob/87e509a2e5a100d221c97df52c6e8be7835f0057/inference/config_671B_v3.2.json
    struct LLMConfig {
        vocab_size   : logic<18>,
        vocab_dim    : logic<16>,
        inter_dim    : logic<16>,
        moe_inter_dim: logic<16>,

        layer_num      : logic<8>,
        layer_dense_num: logic<8>,
        head_num       : logic<8>,
    }
}
