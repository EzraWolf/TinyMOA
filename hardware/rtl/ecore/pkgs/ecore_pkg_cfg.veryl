// configure the entire CPU here

pub package ecore_pkg_cfg {
    const XLEN: u32 = 32; // 32 or 64 ONLY!!

    const USE_LINUX: bbool = true;

    const USE_BASE_I: bbool = true || USE_LINUX;
    const USE_BASE_E: bbool = false && !USE_BASE_I;

    // IMAFDC_Zbb_Zcb_Zicsr_Zicond_Zifencei_Zfbfmin
    const USE_EXT_Zfbfmin : bbool = true || USE_LINUX;
    const USE_EXT_Zifencei: bbool = true || USE_LINUX;
    const USE_EXT_Zicond  : bbool = true || USE_LINUX;
    const USE_EXT_Zcb     : bbool = true || USE_LINUX;
    const USE_EXT_Zbb     : bbool = true || USE_LINUX;
    const USE_EXT_C       : bbool = true || USE_LINUX;
    const USE_EXT_Zca     : bbool = USE_EXT_C || USE_EXT_Zcb;
    const USE_EXT_D       : bbool = true || USE_LINUX;
    const USE_EXT_F       : bbool = true || USE_LINUX || USE_EXT_D || USE_EXT_Zfbfmin;
    const USE_EXT_Zicsr   : bbool = true || USE_LINUX || USE_EXT_F;
    const USE_EXT_A       : bbool = true || USE_LINUX;
    const USE_EXT_M       : bbool = true || USE_LINUX;
    // const USE_EXT_LPU     : bbool = pkg_lpu::LPU_EN; // custom LPU ISA

    const FLEN  : u32 = if USE_EXT_D ? 64 : if USE_EXT_F ? 32 : 0;
    const IALIGN: u32 = if USE_EXT_Zca ? 16 : 32;

    const ARCH_REGFILE_NUM: u32 = if USE_BASE_E ? 16 : 32;

    // required linux MMUs, let params auto set
    const USE_MMU_Sv32: bbool = USE_LINUX && XLEN == 32;
    const USE_MMU_Sv39: bbool = USE_LINUX && XLEN == 64;

    // multiplex FU inputs
    // NONE is treated not as MUX input but gating for surrounding logic
    enum FuSrc1: logic<2> {
        NONE,
        REG,
        PC,
    }
    enum FuSrc2: logic<2> {
        NONE,
        REG,
        IMM,
    }
    enum WbSel: logic<2> {
        NONE,
        MEM,
        FU,
        PC,
    }

    // CPU frontend
    const USE_BPU: bbool = false;

    // CPU backend functional units (FUs)
    // const ALU_NUM: u32 = 4;
    // const FPU_NUM: u32 = 2;
    // const VPU_NUM: u32 = 2;
    // const AGU_NUM: u32 = 2;
}
