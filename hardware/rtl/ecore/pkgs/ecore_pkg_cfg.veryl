// configure the entire CPU here

pub package ecore_pkg_cfg {
    const XLEN: u32 = 32; // 32 or 64 ONLY!!

    // CPU always enabled
    const USE_LINUX: bbool = true;

    // IMAFDC_Zbb_Zcb_Zicsr_Zicond_Zifencei_Zfbfmin
    const USE_EXT_Zfbfmin : bbool = true;
    const USE_EXT_Zifencei: bbool = true || USE_LINUX;
    const USE_EXT_Zicond  : bbool = true;
    const USE_EXT_Zicsr   : bbool = true || USE_LINUX;
    const USE_EXT_Zcb     : bbool = true; // Zca not added, Zcb is the superset
    const USE_EXT_Zbb     : bbool = true;
    const USE_EXT_C       : bbool = true || USE_EXT_Zcb; // recommended if using linux
    const USE_EXT_D       : bbool = true || USE_LINUX;
    const USE_EXT_F       : bbool = true || USE_LINUX || USE_EXT_D || USE_EXT_Zfbfmin;
    const USE_EXT_A       : bbool = true || USE_LINUX;
    const USE_EXT_M       : bbool = true || USE_LINUX;
    const USE_EXT_I       : bbool = true || USE_LINUX;
    const USE_EXT_E       : bbool = false;
    // const USE_EXT_LPU     : bbool = pkg_lpu::LPU_EN; // custom LPU ISA

    // required linux MMUs, let params auto set
    const USE_MMU_Sv32: bbool = USE_LINUX && (XLEN >= 32 && XLEN <: 64);
    const USE_MMU_Sv39: bbool = USE_LINUX && (XLEN >= 64);

    // multiplex FU inputs
    // NONE is treated not as MUX input but gating for surrounding logic
    enum FuSrc1: logic<2> { NONE, REG, PC     }
    enum FuSrc2: logic<2> { NONE, REG, IMM    }
    enum WbSel : logic<2> { NONE, MEM, FU, PC }

    // CPU frontend
    const USE_BPU: bbool = false;

    const ARCH_REGFILE_NUM: u32 = if USE_EXT_E ? 16 : 32;

    // CPU backend functional units (FUs)
    // const ALU_NUM: u32 = 4;
    // const FPU_NUM: u32 = 2;
    // const VPU_NUM: u32 = 2;
    // const AGU_NUM: u32 = 2;
}
