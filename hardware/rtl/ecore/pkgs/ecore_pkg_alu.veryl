// all instructions here can double as appropriate immediate ops
// e.g., "ADD" works the same as "ADDI"

pub package ecore_pkg_alu {
    enum AluOp: logic<4> {
        ADD  = 4'b0000,
        SUB  = 4'b0001,
        SLL  = 4'b0010,
        SRL  = 4'b0011,
        SRA  = 4'b0100,
        AND  = 4'b0101,
        OR   = 4'b0110,
        XOR  = 4'b0111,

        ADDW = 4'b1000,
        SUBW = 4'b1001,
        SLLW = 4'b1010,
        SRLW = 4'b1011,
        SRAW = 4'b1100,

        SLT  = 4'b1101,
        SLTU = 4'b1110,
    }
}
