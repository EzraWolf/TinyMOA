pub module ecore_regfile #(
    param WIDTH  : u32 = 32,
    param DEPTH  : u32 = 32,
    param R_PORTS: u32 = 2,
    param W_PORTS: u32 = 1,
) (
    clk: input clock,
    // rst: input reset,

    i_wen  : input  logic                [W_PORTS],
    i_waddr: input  logic<$clog2(DEPTH)> [W_PORTS],
    i_wdata: input  logic       <WIDTH>  [W_PORTS],

    i_raddr: input  logic<$clog2(DEPTH)> [R_PORTS],
    o_rdata: output logic       <WIDTH>  [R_PORTS],
) {
    // writing to x0 changes nothing, spare the LUTRAM
    type t_reg = bit<WIDTH>;
    var regs: t_reg [DEPTH];

    // no reset significantly reduces size
    always_ff (clk) {
        for i in 0..W_PORTS {
            if i_wen[i] && i_waddr[i] != 0 {
                regs[i_waddr[i]] = i_wdata[i] as t_reg;
            }
        }
    }

    for i in 0..R_PORTS :gen_read_ports {
        assign o_rdata[i] = regs[i_raddr[i]];
    }
}
