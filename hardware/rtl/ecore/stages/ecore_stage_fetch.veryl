pub module ecore_stage_fetch #(
    param WIDTH: u32 = 32,
) (
    clk: input clock,
    rst: input reset,

    i_valid     : input logic,
    i_pc        : input logic<WIDTH>,

    o_imem_valid: output logic,
    i_imem_ready: input  logic,
    o_imem_addr : output logic<WIDTH>,
    i_imem_rdata: input  logic<32>,

    o_valid     : output logic,
    i_ready     : input  logic,
    o_pc        : output logic<WIDTH>,
    o_instr     : output logic<32>,
) {
    var pc: logic<WIDTH>;

    assign o_imem_valid = !o_valid || i_ready || i_valid;
    assign o_imem_addr  = if i_valid ? i_pc : pc;

    always_ff (clk, rst) {
        if_reset {
            pc      = '0; // TODO: add PC_RST if needed
            o_valid = '0;
            o_pc    = '0;
            o_instr = '0;
        } else if o_imem_valid {
            o_valid = i_imem_ready;

            if i_imem_ready {
                pc      = o_imem_addr + 4;
                o_pc    = o_imem_addr;
                o_instr = i_imem_rdata;
            } else if i_valid { pc = i_pc; }
        }
    }
}
