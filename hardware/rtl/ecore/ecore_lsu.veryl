pub module ecore_lsu #(
    param WIDTH: u32 = 32,
) (
    i_addr      : input  logic<WIDTH>,
    i_store_data: input  logic<WIDTH>,
    i_op        : input  logic<3>, // funct3
    i_is_load   : input  logic,
    i_is_store  : input  logic,
    i_rdata     : input  logic<WIDTH>,

    o_wdata     : output logic<WIDTH>,
    o_wmask     : output logic<WIDTH / 8>,
    o_load_data : output logic<WIDTH>,
    o_error     : output logic,
) {
    var store_mask : logic<WIDTH / 8>;
    var align_mask : logic<3>;

    let byte_offset: logic<$clog2(WIDTH / 8)> = i_addr[$clog2(WIDTH / 8) - 1:0];
    let bit_offset : logic<$clog2(WIDTH)>     = {byte_offset, 3'b0};
    let shift_rdata: logic<WIDTH>             = i_rdata      >> bit_offset;
    let shift_wdata: logic<WIDTH>             = i_store_data << bit_offset;
    let is_misalign: logic                    = (i_addr[2:0]  & align_mask) != 0;

    always_comb {
        case i_op[1:0] {
            2'b00: {
                store_mask = {1'b0 repeat WIDTH / 8 - 1, 1'b1};
                align_mask = 3'b000;
            }
            2'b01: {
                store_mask = {1'b0 repeat WIDTH / 8 - 2, 2'b11};
                align_mask = 3'b001;
            }
            2'b10: {
                store_mask = {1'b0 repeat WIDTH / 8 - 4, 4'b1111};
                align_mask = 3'b011;
            }
            default: {
                store_mask = '1;
                align_mask = 3'b111;
            }
        }
    }

    always_comb {
        o_wdata     = if (i_is_store) ? shift_wdata : '0;
        o_wmask     = '0;
        o_load_data = '0;
        o_error     = 1'b0;

        if i_is_store {
            case i_op {
                3'b000: { // SB
                    o_wmask = store_mask << byte_offset;
                }
                3'b001: { // SH
                    o_wmask = store_mask << byte_offset;
                    o_error = is_misalign;
                }
                3'b010: { // SW
                    o_wmask = store_mask << byte_offset;
                    o_error = is_misalign;
                }
                3'b011: { // SD
                    if WIDTH >= 64 {
                        o_wmask = store_mask << byte_offset;
                        o_error = is_misalign;
                    } else { o_error = 1'b1; }
                }
                default: o_error = 1'b1;
            }
        }

        if i_is_load {
            case i_op {
                3'b010: { // LW
                    o_load_data = {shift_rdata[31] repeat WIDTH - 32, shift_rdata[31:0]};
                    o_error     = is_misalign;
                }
                3'b000: { // LB
                    o_load_data = {shift_rdata[7] repeat WIDTH - 8, shift_rdata[7:0]};
                } 
                3'b100: { // LBU
                    o_load_data = {1'b0 repeat WIDTH - 8, shift_rdata[7:0]};
                }
                3'b001: { // LH
                    o_load_data = {shift_rdata[15] repeat WIDTH - 16, shift_rdata[15:0]};
                    o_error     = is_misalign;
                }
                3'b101: { // LHU
                    o_load_data = {1'b0 repeat WIDTH - 16, shift_rdata[15:0]};
                    o_error     = is_misalign;
                }
                3'b011: { // LD
                    if WIDTH >= 64 {
                        o_load_data = i_rdata;
                        o_error     = is_misalign;
                    } else { o_error = 1'b1; }
                }
                3'b110: { // LWU
                    if WIDTH >= 64 {
                        o_load_data = {1'b0 repeat WIDTH - 32, shift_rdata[31:0]};
                        o_error     = is_misalign;
                    } else { o_error = 1'b1; }
                }
                default: o_error = 1'b1;
            }
        }

        if o_error {
            o_wmask     = '0;
            o_load_data = '0;
        }
    }
}
