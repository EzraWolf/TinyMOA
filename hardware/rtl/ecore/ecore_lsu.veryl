pub module ecore_lsu #(
    param WIDTH: u32 = 32,
) (
    i_addr      : input  logic<WIDTH>,
    i_store_data: input  logic<WIDTH>,
    i_op        : input  logic<3>, // funct3
    i_is_load   : input  logic,
    i_is_store  : input  logic,
    i_rdata     : input  logic<WIDTH>,

    o_wdata     : output logic<WIDTH>,
    o_wmask     : output logic<WIDTH / 8>,
    o_load_data : output logic<WIDTH>,
    o_error     : output logic,
) {
    let byte_offset  : logic<$clog2(WIDTH / 8)> = i_addr[$clog2(WIDTH / 8) - 1:0];
    let bit_offset   : logic<$clog2(WIDTH)>     = {byte_offset, 3'b0};
    let shifted_rdata: logic<WIDTH>             = i_rdata >> bit_offset;

    always_comb {
        o_wdata     = i_store_data << bit_offset;
        o_wmask     = '0;
        o_load_data = '0;
        o_error     = 1'b0;

        if i_is_store {
            case i_op {
                3'b000: { // SB
                    o_wmask = {1'b0 repeat WIDTH / 8 - 1, 1'b1} << byte_offset;
                }
                3'b001: { // SH
                    o_wmask = {1'b0 repeat WIDTH / 8 - 2, 2'b11} << byte_offset;
                    o_error = i_addr[0];
                }
                3'b010: { // SW
                    o_wmask = {1'b0 repeat WIDTH / 8 - 4, 4'b1111} << byte_offset;
                    o_error = i_addr[1:0] != 0;
                }
                3'b011: { // SD
                    if WIDTH >= 64 {
                        o_wmask = '1;
                        o_error = i_addr[2:0] != 0;
                    } else {
                        o_error = 1'b1;
                    }
                }
                default: o_error = 1'b1;
            }
        }

        if i_is_load {
            case i_op {
                3'b010: { // LW
                    o_load_data = {shifted_rdata[31] repeat WIDTH - 32, shifted_rdata[31:0]};
                    o_error = i_addr[1:0] != 0;
                }
                3'b000: { // LB
                    o_load_data = {shifted_rdata[7] repeat WIDTH - 8, shifted_rdata[7:0]};
                } 
                3'b100: { // LBU
                    o_load_data = {1'b0 repeat WIDTH - 8, shifted_rdata[7:0]};
                }
                3'b001: { // LH
                    o_load_data = {shifted_rdata[15] repeat WIDTH - 16, shifted_rdata[15:0]};
                    o_error = i_addr[0];
                }
                3'b101: { // LHU
                    o_load_data = {1'b0 repeat WIDTH - 16, shifted_rdata[15:0]};
                    o_error = i_addr[0];
                }
                3'b011: { // LD
                    if WIDTH >= 64 {
                        o_load_data = shifted_rdata;
                        o_error = i_addr[2:0] != 0;
                    } else {
                        o_error = 1'b1;
                    }
                }
                3'b110: { // LWU
                    if WIDTH >= 64 {
                        o_load_data = {1'b0 repeat WIDTH - 32, shifted_rdata[31:0]};
                        o_error = i_addr[1:0] != 0;
                    } else {
                        o_error = 1'b1;
                    }
                }
                default: o_error = 1'b1;
            }
        }

        if o_error {
            o_wmask     = '0;
            o_load_data = '0;
        }
    }
}
