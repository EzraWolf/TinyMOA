// RV32I decoder
// soon RV32I/RV64I + MAFC_Zicsr_Zifencei_BF16
import pkg_cpu::SrcType;
import pkg_cpu::DstType;
import pkg_cpu_alu::AluOp;

pub module cpu_decoder (
    i_instr   : input  logic<32>,

    o_rs2     : output logic<5>,
    o_rs1     : output logic<5>,
    o_rd      : output logic<5>,

    o_imm     : output logic<32>,

    o_fu_op   : output AluOp,
    o_fu_src_b: output SrcType,
    o_fu_src_a: output SrcType,
    o_fu_dst  : output DstType,
) {
    let imm_i : logic<31> = {i_instr[msb] repeat 21, i_instr[30:20]};
    let imm_s : logic<31> = {i_instr[msb] repeat 21, i_instr[30:25], i_instr[11:7]};
    let imm_b : logic<32> = {i_instr[msb] repeat 20, i_instr[7], i_instr[30:25], i_instr[11:8], 1'b0};
    let imm_j : logic<32> = {i_instr[msb] repeat 11, i_instr[19:12], i_instr[20], i_instr[30:21], 1'b0};
    let imm_u : logic<32> = {i_instr[31:12], 12'b0};
    let shamnt: logic<32> = {0 repeat 27, i_instr[24:20]};

    let funct7: logic<7> = i_instr[31:25];
    let rs2   : logic<5> = i_instr[24:20];
    let rs1   : logic<5> = i_instr[19:15];
    let funct3: logic<3> = i_instr[14:12];
    let rd    : logic<5> = i_instr[11:7];
    let quad  : logic<2> = i_instr[1:0];
    let op    : logic<5> = i_instr[6:2];

    always_comb {
        o_rs2 = '0;
        o_rs1 = '0;
        o_rd  = '0;
        o_imm = '0;

        o_fu_op    = AluOp::ADD;
        o_fu_src_a = SrcType::ZERO;
        o_fu_src_b = SrcType::ZERO;
        o_fu_dst   = DstType::REG;

        case quad {
            // 2'b00: {}
            // 2'b01: {}
            // 2'b10: {}

            // full RV32I/RV64I
            2'b11: {
                o_rs2 = rs2;
                o_rs1 = rs1;
                o_rd  = rd;
                o_fu_src_a = SrcType::REG;
                o_fu_src_b = SrcType::REG;
                o_fu_dst   = DstType::REG;

                case op {

                    // R (01100) and I (00100) Type, ALU ops
                    // only difference is where the source regs come from
                    5'b01100, 5'b00100: {
                        if op == 5'b00100 {
                            o_fu_src_b = SrcType::IMM;
                            o_rs2 = '0;
                            o_imm = imm_i;
                        }
                        case funct3 {
                            3'b000: {
                                if op == 5'b01100 && funct7 == 7'b0100000 {
                                    o_fu_op = AluOp::SUB;
                                } else { o_fu_op = AluOp::ADD; }
                            }
                            3'b111: { o_fu_op = AluOp::AND; }
                            3'b110: { o_fu_op = AluOp::OR;  }
                            3'b100: { o_fu_op = AluOp::XOR; }
                            3'b001: { 
                                if op == 5'b00100 { o_imm = shamnt; }
                                o_fu_op = AluOp::SLL;
                            }
                            3'b101: {
                                if op == 5'b00100 { o_imm = shamnt; }
                                case funct7 {
                                    7'b0000000: { o_fu_op = AluOp::SRL; }
                                    7'b0100000: { o_fu_op = AluOp::SRA; }
                                }
                            }
                            3'b010:  { o_fu_op = AluOp::SLT;  }
                            3'b011:  { o_fu_op = AluOp::SLTU; }
                        }
                    }

                    // I-Type, load
                    5'b00000: {}

                    // I-Type, JALR
                    5'b11001: {}

                    // S-Type, store
                    5'b01000: {}

                    // B-Type, branch
                    5'b11000: {
                        
                    }

                    // U-Type: AUIPC (00101), LUI (01101)
                    // TODO: assign at rename, skip backend (ALU) altogether
                    5'b00101, 5'b01101: {}

                    // J-Type, JAL
                    5'b11011: {}

                    // SYSTEM
                    5'b11100: {}

                    // FENCE
                    5'b00011: {}

                    default: {}
                }
            }
        }
    }
}
