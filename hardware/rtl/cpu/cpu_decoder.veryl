// RV32I decoder. soon to be RV32I/RV64I + optional MAFC_Zicsr_Zifencei_BF16
import pkg_cpu::*;
import pkg_cpu_alu::*;

pub module cpu_decoder (
    i_instr     : input  logic<32>,

    o_rf_wen    : output logic,
    o_rf_dst    : output logic<5>,
    o_rf_src1   : output logic<5>,
    o_rf_src2   : output logic<5>,

    o_fu_op     : output AluOp,
    o_fu_src1   : output FuSrc1,
    o_fu_src2   : output FuSrc2,
    o_imm       : output logic<32>,

    o_mem_ren   : output logic,
    o_mem_wen   : output logic,

    o_wb_sel    : output WbSel,

    o_funct3    : output logic<3>, // for branch & LSU
    o_is_load   : output logic,
    o_is_store  : output logic,
    o_is_jump   : output logic,
    o_is_branch : output logic,
    o_is_illegal: output logic,
) {
    let imm_i : logic<32> = {i_instr[msb] repeat 21, i_instr[30:20]};
    let imm_s : logic<32> = {i_instr[msb] repeat 21, i_instr[30:25], i_instr[11:7]};
    let imm_b : logic<32> = {i_instr[msb] repeat 20, i_instr[7],     i_instr[30:25], i_instr[11:8],  1'b0};
    let imm_j : logic<32> = {i_instr[msb] repeat 12, i_instr[19:12], i_instr[20],    i_instr[30:21], 1'b0};
    let imm_u : logic<32> = {i_instr[31:12], 12'b0};

    let funct7: logic<7>  = i_instr[31:25];
    let rs2   : logic<5>  = i_instr[24:20];
    let rs1   : logic<5>  = i_instr[19:15];
    let funct3: logic<3>  = i_instr[14:12];
    let rd    : logic<5>  = i_instr[11:7];
    let op    : logic<5>  = i_instr[6:2];
    let quad  : logic<2>  = i_instr[1:0];

    assign o_rf_src1 = if (o_fu_src1 == FuSrc1::REG) ? rs1 : 5'b0;
    assign o_rf_src2 = if (o_fu_src2 == FuSrc2::REG || o_is_store) ? rs2 : 5'b0;
    assign o_rf_dst  = if (o_wb_sel  != WbSel::NONE ) ? rd  : 5'b0;
    assign o_rf_wen  = o_wb_sel      != WbSel::NONE;
    assign o_mem_ren = o_is_load     == 1'b1 || o_wb_sel == WbSel::MEM;
    assign o_mem_wen = o_is_store    == 1'b1;

    always_comb {
        o_fu_op      = AluOp::ADD;
        o_fu_src1    = FuSrc1::NONE;
        o_fu_src2    = FuSrc2::NONE;
        o_imm        = 32'b0;
        o_wb_sel     = WbSel::NONE;
        o_funct3     = 3'b0;
        o_is_load    = 1'b0;
        o_is_store   = 1'b0;
        o_is_jump    = 1'b0;
        o_is_branch  = 1'b0;
        o_is_illegal = 1'b0;

        case quad {
            // 2'b00: {}
            // 2'b01: {}
            // 2'b10: {}
            2'b11: { // full RV32I/RV64I/RV128I
                o_fu_src1 = FuSrc1::REG;
                o_fu_src2 = FuSrc2::REG;
                o_wb_sel  = WbSel::FU;
                o_funct3  = funct3;

                case op {
                    5'b01100: { // R-Type ALU reg-reg ops
                        case {funct3, funct7} {
                            {3'b000, 7'b0000000}: o_fu_op = AluOp::ADD;
                            {3'b000, 7'b0100000}: o_fu_op = AluOp::SUB;
                            {3'b111, 7'b0000000}: o_fu_op = AluOp::AND;
                            {3'b110, 7'b0000000}: o_fu_op = AluOp::OR;
                            {3'b100, 7'b0000000}: o_fu_op = AluOp::XOR;
                            {3'b001, 7'b0000000}: o_fu_op = AluOp::SLL;
                            {3'b101, 7'b0000000}: o_fu_op = AluOp::SRL;
                            {3'b101, 7'b0100000}: o_fu_op = AluOp::SRA;
                            {3'b010, 7'b0000000}: o_fu_op = AluOp::SLT;
                            {3'b011, 7'b0000000}: o_fu_op = AluOp::SLTU;
                            default: o_is_illegal = 1'b1;
                        }
                    }
                    5'b00100: { // I-Type ALU reg-immediate ops
                        o_fu_src2 = FuSrc2::IMM;
                        o_imm     = imm_i;
                        case funct3 {
                            3'b000: o_fu_op = AluOp::ADD;
                            3'b111: o_fu_op = AluOp::AND;
                            3'b110: o_fu_op = AluOp::OR;
                            3'b100: o_fu_op = AluOp::XOR;
                            3'b010: o_fu_op = AluOp::SLT;
                            3'b011: o_fu_op = AluOp::SLTU;
                            3'b001, 3'b101: {
                                case {funct3, funct7} {
                                    {3'b001, 7'b0000000}: o_fu_op = AluOp::SLL;
                                    {3'b101, 7'b0000000}: o_fu_op = AluOp::SRL;
                                    {3'b101, 7'b0100000}: o_fu_op = AluOp::SRA;
                                    default: o_is_illegal = 1'b1;
                                }
                            }
                            default: o_is_illegal = 1'b1;
                        }
                    }
                    5'b00000: { // I-Type load ops
                        o_fu_src2 = FuSrc2::IMM;
                        o_imm     = imm_i;
                        o_wb_sel  = WbSel::MEM;
                        o_is_load = 1'b1;
                        case funct3 {
                            3'b010        : {} // LW
                            3'b001, 3'b101: {} // LH, LHU
                            3'b000, 3'b100: {} // LB, LBU
                            default: o_is_illegal = 1'b1;
                        }
                    }
                    5'b01000: { // S-Type store ops
                        o_fu_src2  = FuSrc2::IMM;
                        o_imm      = imm_s;
                        o_wb_sel   = WbSel::NONE;
                        o_is_store = 1'b1;
                        case funct3 {
                            3'b010: {} // SW
                            3'b001: {} // SH
                            3'b000: {} // SB
                            default: o_is_illegal = 1'b1;
                        }
                    }
                    5'b11011: { // J-Type JAL
                        o_fu_src1  = FuSrc1::PC;
                        o_fu_src2  = FuSrc2::IMM;
                        o_imm      = imm_j;
                        o_wb_sel   = WbSel::PC;
                        o_is_jump  = 1'b1;
                    }
                    5'b11001: { // J-Type JALR
                        o_fu_src1  = FuSrc1::REG;
                        o_fu_src2  = FuSrc2::IMM;
                        o_imm      = imm_i;
                        o_wb_sel   = WbSel::PC;
                        o_is_jump  = 1'b1;
                        if funct3 != 3'b000 { o_is_illegal = 1'b1; }
                    }
                    5'b11000: { // B-Type branch ops
                        o_wb_sel    = WbSel::NONE;
                        o_imm       = imm_b;
                        o_is_branch = 1'b1;
                        case funct3 {
                            3'b000, 3'b001: {} // BEQ, BNE
                            3'b100, 3'b110: {} // BLT, BLTU
                            3'b101, 3'b111: {} // BGE, BGEU
                            default: o_is_illegal = 1'b1;
                        }
                    }
                    5'b00101, 5'b01101: { // U-Type AUIPC, LUI
                        // TODO: assign at rename, skip backend (ALU) altogether
                        o_fu_src1 = if op[3] == 1'b0 ? FuSrc1::PC : FuSrc1::NONE; // AUIPC:LUI
                        o_fu_src2 = FuSrc2::IMM;
                        o_wb_sel  = WbSel::FU;
                        o_imm     = imm_u;
                    }
                    // 5'b11100: {} // TODO: system
                    // 5'b00011: {} // TODO: fence
                    default: o_is_illegal = 1'b1;
                }
            }
            default: o_is_illegal = 1'b1;
        }
    }
}
