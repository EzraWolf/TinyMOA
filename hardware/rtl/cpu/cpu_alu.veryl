import pkg_cpu_alu::*;

pub module cpu_alu #(
    param WIDTH: u32 = 64,
) (
    i_op: input pkg_cpu_alu::AluOp,

    i_a: input logic<WIDTH>,
    i_b: input logic<WIDTH>,

    o_res: output logic<WIDTH>,
) {

    var result: logic<WIDTH>;

    let shamt: logic<$clog2(WIDTH)> = i_b[$clog2(WIDTH) - 1:0];

    always_comb {
        case (i_op) {
            AluOp::ADD : result = i_a + i_b;
            AluOp::SUB : result = i_a - i_b;
            AluOp::AND : result = i_a & i_b;
            AluOp::OR  : result = i_a | i_b;
            AluOp::XOR : result = i_a ^ i_b;
            AluOp::SLL : result = i_a << shamt;
            AluOp::SRL : result = i_a >> shamt;
            AluOp::SRA : result = $signed(i_a) >>> shamt;
            AluOp::SLT : result = {1'b0 repeat (WIDTH - 'b1), $signed(i_a) <: $signed(i_b)};
            AluOp::SLTU: result = {1'b0 repeat (WIDTH - 'b1), i_a <: i_b};
            default    : result = '0;
        }
    }

    if (WIDTH >= 64) :gen_w_ops {
        var w_result: logic<WIDTH>;

        let i_a32: logic<32> = i_a[31:0];
        let i_b32: logic<32> = i_b[31:0];

        let add32: logic<32> = i_a32 + i_b32;
        let sub32: logic<32> = i_a32 - i_b32;
        let sll32: logic<32> = i_a32 << shamt;
        let srl32: logic<32> = i_a32 >> shamt;
        let sra32: logic<32> = $signed(i_a32) >>> shamt;

        always_comb {
            case (i_op) {
                AluOp::ADDW: w_result = {add32[msb] repeat WIDTH - 32, add32};
                AluOp::SUBW: w_result = {sub32[msb] repeat WIDTH - 32, sub32};
                AluOp::SLLW: w_result = {sll32[msb] repeat WIDTH - 32, sll32};
                AluOp::SRLW: w_result = {srl32[msb] repeat WIDTH - 32, srl32};
                AluOp::SRAW: w_result = {sra32[msb] repeat WIDTH - 32, sra32};
                default    : w_result = '0;
            }
        }

        assign o_res = result | w_result;
    } else :gen_no_w_ops {
        assign o_res = result;
    }
}
