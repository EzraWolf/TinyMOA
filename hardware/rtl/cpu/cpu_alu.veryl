import pkg_cpu_alu::*;

pub module cpu_alu #(
    param WIDTH: u32 = 64,
) (
    i_op: input pkg_cpu_alu::AluOp,

    i_a: input logic<WIDTH>,
    i_b: input logic<WIDTH>,

    o_res: output logic<WIDTH>,
) {

    var result : logic<WIDTH>;
    let shamt  : logic<6>  = i_b[$clog2(WIDTH)-1:0];
    let shamt32: logic<5>  = i_b[4:0];

    let i_a32: logic<32> = i_a[31:0];
    let i_b32: logic<32> = i_b[31:0];

    let add32: logic<32> = i_a32 + i_b32;
    let sub32: logic<32> = i_a32 - i_b32;
    let sll32: logic<32> = i_a32 << shamt32;
    let srl32: logic<32> = i_a32 >> shamt32;
    let sra32: logic<32> = $signed(i_a32) >>> shamt32;

    always_comb {
        case (i_op) {
            AluOp::ADD : result = i_a + i_b;
            AluOp::ADDW: result = {add32[31] repeat 32, add32};
            AluOp::SUB : result = i_a - i_b;
            AluOp::SUBW: result = {sub32[31] repeat 32, sub32};
            AluOp::OR  : result = i_a | i_b;
            AluOp::AND : result = i_a & i_b;
            AluOp::XOR : result = i_a ^ i_b;

            AluOp::SLL : result = i_a << shamt;
            AluOp::SLLW: result = {sll32[31] repeat 32, sll32};
            AluOp::SRL : result = i_a >> shamt;
            AluOp::SRLW: result = {srl32[31] repeat 32, srl32};
            AluOp::SRA : result = $signed(i_a) >>> shamt;
            AluOp::SRAW: result = {sra32[31] repeat 32, sra32};

            AluOp::SLT : result = {63'b0, $signed(i_a) <: $signed(i_b)};
            AluOp::SLTU: result = {63'b0, i_a <: i_b};

            default    : result = 64'b0;
        }
    }
    assign o_res = result;
}

pub module dut_cpu_alu (
    i_op: input pkg_cpu_alu::AluOp,

    i_a: input logic<64>,
    i_b: input logic<64>,

    o_res: output logic<64>,
) {
    initial {
        $dumpfile("dut_cpu_alu.fst");
        $dumpvars(0, dut_cpu_alu);
    }

    inst dut_cpu_alu: cpu_alu (i_op, i_a, i_b, o_res);
}
