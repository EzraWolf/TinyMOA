pub module mem_fifo #(
    param WIDTH: u32 = 64,
    param DEPTH: u32 = 128,
) (
    clk: input clock,
    rst: input reset,

    i_wen  : input  logic,
    i_data : input  logic<WIDTH>,

    i_ren  : input  logic,    
    o_data : output logic<WIDTH>,

    o_full : output logic,
    o_empty: output logic,
) {
    const PTR_WIDTH: u32 = if DEPTH >: 1 ? $clog2(DEPTH) : 1;
    type t_ptr = logic<PTR_WIDTH>;
    const PTR_LAST: t_ptr = (DEPTH - 1) as t_ptr;

    var buffer: logic<WIDTH> [DEPTH];

    var w_ptr: t_ptr;
    var r_ptr: t_ptr;

    var is_read: logic;

    // write
    always_ff (clk, rst) {
        if_reset {
            w_ptr = '0;
            for i in 0..DEPTH {
                buffer[i] = '0;
            }
        } else {
            if i_wen && !o_full {
                buffer[w_ptr] = i_data;
                w_ptr = if w_ptr == PTR_LAST ? '0 : w_ptr + 1'b1;
            }
        }
    }

    // read
    always_ff (clk, rst) {
        if_reset {
            r_ptr  = '0;
            o_data = '0;
        } else {
            if i_ren && !o_empty {
                o_data = buffer[r_ptr];
                r_ptr  = if r_ptr == PTR_LAST ? '0 : r_ptr + 1'b1;
            }
        }
    }

    // control
    always_ff (clk, rst) {
        if_reset {
            is_read = 1'b1;
        } else {
            if i_ren && !o_empty {
                is_read = 1'b1;
            } else if i_wen && !o_full {
                is_read = 1'b0;
            } else {
                is_read = is_read;
            }
        }
    }

    assign o_full  = r_ptr == w_ptr && !is_read;
    assign o_empty = r_ptr == w_ptr && is_read;
}

pub module dut_mem_fifo #(
    param WIDTH: u32 = 64 ,
    param DEPTH: u32 = 128,
) (
    clk: input clock,
    rst: input reset,

    i_wen : input  logic       ,
    i_data: input  logic<WIDTH>,
    o_full: output logic       ,

    i_ren  : input  logic       ,
    o_data : output logic<WIDTH>,
    o_empty: output logic       ,
) {
    initial {
        $dumpfile("dut_mem_fifo.fst");
        $dumpvars(0, dut_mem_fifo);
    }

    inst dut_mem_fifo: mem_fifo #( WIDTH, DEPTH ) ( clk, rst, i_wen, i_data, o_full, i_ren, o_data, o_empty );
}
